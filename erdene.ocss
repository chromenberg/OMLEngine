rule (#url_box) {
	background-color: #f43366;
	corner-radius:5;
	height: 23;
	
}
rule (body) {
	background-color: #14121C;
}
rule (.buttonText) {
  color: #ff0000;
}

rule (.downloadContainer) {
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  direction: column;
  gap: 8;
}

rule (.downloadButton) {
  corner-radius: 16;
  width: 200;
  height: 40;
  background-color: #26282C;
  align-items: center;
  justify-content: center;
}

rule (.searchBox) {
  corner-radius: 16;
  width: 200;
  height: 40;
  background-color: #191A1C;
  align-items: center;
  justify-content: center;
}