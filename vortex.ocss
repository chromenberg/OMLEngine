rule (#root) {
  width: 100%;
  height: 100%;
  background-color: #120b1b;
}

rule (.launcherContainer) {
  width: 100%;
  height: 100%;
  direction: column;
}

rule (.textSubheader) {
  font-size: 24;
  color: #ffffff;
  font-weight: bold;
}

rule (.textHeader) {
  font-size: 32;
  color: #ffffff;
  font-weight: bold;
}

rule (.appContainer) {
  width: grow;
  height: grow;
  direction: row;
  padding: 0 32 24 32;
}

rule (.appContent) {
  background-color: #08050e;
  border-color: #24242f;
  border-width: 1;
  width: grow;
  height: grow;
  corner-radius: 8;
  padding: 32;
}

rule (.welcomeContainer) {
  direction: row;
  gap: 16;
}

rule (.avatarContainer) {
  width: 180;
  height: 250;
  border-color: #24242f;
  border-width: 1;
}

rule (.avatarDecoContainer) {
  gap: 16;
  height: grow;
  direction: column;
}



rule (.sidebarItem) {
  corner-radius: 8;
  height: 40;
  justify-content: center;
  width: grow;
  padding: 8;
}

rule (.sidebarContainer) {
  width: 200;
  background-color: #120b1b;
  height: 100%;
  direction: column;
  gap: 8;
  padding: 0 32 0 0;
}

rule (.appHeader) {
  height: 60;
  width: 100%;
}



rule (.friendsListContainer) {
  gap: 8;
  direction: column;
}

rule (.friendsList) {
  gap: 12;
}

rule (.friendContainer) {
  width: 100;
  height: 100;
  background-color: #26263a;
  border-width: 1;
  border-color: #33334a;
  corner-radius: 8;
}