                          Click For Free Volts
                        </text>                      
                      </rect>
                      <rect class="gameContainer">
                        <rect class="gameIcon" />
                        <text class="textNormal gameName">
                          Click For Free Volts
                        </text>                      
                      </rect>
                      <rect class="gameContainer">
                        <rect class="gameIcon" />
                        <text class="textNormal gameName">
                          Click For Free Volts
                        </text>                      
                      </rect>
                      <rect class="gameContainer">
                        <rect class="gameIcon" />
                        <text class="textNormal gameName">
                          Click For Free Volts
                        </text>                      
                      </rect>
                    </rect>
                  </rect>
  
                  <rect class="gameCategory">
                    <rect class="categoryNameContainer">
