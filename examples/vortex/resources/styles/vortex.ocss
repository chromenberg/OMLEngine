rule (#root) {
  width: 100%;
  height: 100%;
  background-color: #120b1b;
}
rule (#image) {
  width: 100px;
  height: 44.25px;
  align-self:left;
  float-offset: 32px 0px;
}
rule (.launcherContainer) {
  width: 100%;
  height: 100%;
  display: flex;
  flex-wrap: true;
  direction: column;
}

rule (.textNormal) {
  font-size: 22px;
  color: #ffffff;
  font-weight: bold;
}

rule (.textSubheader) {
  font-size: 24px;
  color: #ffffff;
  font-weight: bold;
}

rule (.textHeader) {
  font-size: 32px;
  color: #ffffff;
  font-weight: bold;
}

rule (.mutedTextThin) {
  font-size: 24px;
  color: #9a9aab;
  font-weight: regular;
}

rule (.appContainer) {
  height: 100%;
  direction: row;
  padding: 0px 32px 0px 32px;
	display: flex;
  flex-wrap: true;
}

rule (.appContent) {
  background-color: #08050e;
  border-color: #24242f;
  border-width: 1px;

  height: 100%;
  padding: 32px;
  direction: column;
  gap: 16px;
}

rule (.scroller) {
  overflow-y: scroll;

  height: 100%;
  padding: 0px 0px 32px 0px;
}

rule (.welcomeContainer) {
  direction: row;
  gap: 16px;
}

rule (.avatarContainer) {
  width: 180px;
  height: 250px;
  border-color: #24242f;
  border-width: 1px;
}

rule (#image-test) {
 image-url: "./resources/game.webp";
}

rule (.avatarDecoContainer) {
  gap: 16px;
  height: grow;
  direction: column;
}



rule (.sidebarItem) {
  corner-radius: 8px;
  height: 40px;
  justify-content: center;
  width: grow;
  padding: 8px;
}

rule (.sidebarContainer) {
  width: 200px;
  background-color: #120b1b;
  height: 100%;
  direction: column;
  gap: 8px;
  padding: 0px 32px 0px 0px;
}

rule (.appHeader) {
  height: 60px;
  width: 100%;
  justify-content: center;
  padding: 0px 32px 0px 32px;
  
}

rule (.friendsListContainer) {
	width: 100%;
  gap: 8px;
  direction: column;
}

rule (.friendsList) {
  gap: 12px;
  width: 100%;
  display: flex;
  flex-wrap: true;
  direction: row;
}

rule (.friendContainer) {
  width: 100;
  height: 100;
  background-color: #26263a;
  border-width: 1;
  border-color: #33334a;
  corner-radius: 8;
}

rule (.headerInner) {
  width: 100%;
  align-items: center;
}

rule (#search-box) {
  width: 600px;
  height: 42px;
  background-color: #0b0b12;
  border-color: #24242f;
  border-width: 1px;
  justify-content: center;
  padding: 0px 16px 0px 16px;
  corner-radius: 8px;
}