rule (#root) {
  width: 100%;
  height: 100%;
  background-color: #120b1b;
}
rule (#image) {
  width: 100;
  height: 44.25;
  align-self:left;
  float-offset: 32 0;
}
rule (.launcherContainer) {
  width: 100%;
  height: 100%;
  direction: column;
}

rule (.textNormal) {
  font-size: 22;
  color: #ffffff;
  font-weight: bold;
}

rule (.textSubheader) {
  font-size: 24;
  color: #ffffff;
  font-weight: bold;
}

rule (.textHeader) {
  font-size: 32;
  color: #ffffff;
  font-weight: bold;
}

rule (.mutedTextThin) {
  font-size: 24;
  color: #9a9aab;
  font-weight: regular;
}

rule (.appContainer) {
  width: grow;
  height: grow;
  direction: row;
  padding: 0 32 0 32;
}

rule (.appContent) {
  background-color: #08050e;
  border-color: #24242f;
  border-width: 1;
  width: grow;
  height: grow;
  corner-radius: 8;
  padding: 32;
  direction: column;
  gap: 16;
}

rule (.scroller) {
  overflow-y: scroll;
  width: grow;
  height: grow;
  padding: 0 0 32 0;
  
}

rule (.welcomeContainer) {
  direction: row;
  gap: 16;
}

rule (.avatarContainer) {
  width: 180;
  height: 250;
  border-color: #24242f;
  border-width: 1;
}

rule (#image-test) {
 image-url: "./resources/game.webp";
}

rule (.avatarDecoContainer) {
  gap: 16;
  height: grow;
  direction: column;
}



rule (.sidebarItem) {
  corner-radius: 8;
  height: 40;
  justify-content: center;
  width: grow;
  padding: 8;
}

rule (.sidebarContainer) {
  width: 200;
  background-color: #120b1b;
  height: 100%;
  direction: column;
  gap: 8;
  padding: 0 32 0 0;
}

rule (.appHeader) {
  height: 60;
  width: 100%;
  justify-content: center;
  padding: 0 32 0 32;
  
}

rule (.friendsListContainer) {
  gap: 8;
  direction: column;
}

rule (.friendsList) {
  gap: 12;
}

rule (.friendContainer) {
  width: 100;
  height: 100;
  background-color: #26263a;
  border-width: 1;
  border-color: #33334a;
  corner-radius: 8;
}
rule (.headerInner) {
  width: 100%;
  align-items: center;
}
rule (#search-box) {
  width: 600px;
  height: 42;
  background-color: #0b0b12;
  border-color: #24242f;
  border-width: 1;
  justify-content: center;
  padding: 0 16 0 16;
  corner-radius: 8;
}